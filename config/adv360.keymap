#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define KPL 1
#define MOD 2
#define SYM 3
#define NAV 4
#define HM_A hll SYM A
#define HM_S hll KPL S
#define HM_D hml LCTRL D
#define HM_F hml LSHIFT F
#define HM_J    hmr RSHIFT J
#define HM_K    hmr RCTRL K
#define HM_L    hnl NAV L
#define HM_SEMI hlr SYM SEMI
#define KEYS_LEFT  0  1  2  3  4  5  6 \
                  14 15 16 17 18 19 20 \
                  28 29 30 31 32 33 34 \
                  46 47 48 49 50 51    \
                  60 61 62 63 64
#define KEYS_RIGHT  7  8  9 10 11 12 13 \
                   21 22 23 24 25 26 27 \
                   39 40 41 42 43 44 45 \
                      54 55 56 57 58 59 \
                         71 72 73 74 75
#define KEYS_NAV 29 30 31 32             41 42    44 \
                                      54 55 56 57
#define THUMBS_LEFT 35 36 52 65 66 67
#define THUMBS_RIGHT 37 38 53 68 69 70

&mt {
    tapping-term-ms = <170>;
    quick-tap-ms = <100>;
    flavor = "balanced";
};

/ {
    behaviors {
        #include "macros.dtsi"
	#include "version.dtsi"

        hll: home_row_layer_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <60>;
            tapping-term-ms = <200>;
            quick-tap-ms = <100>;
            bindings = <&mo>, <&kp>;

            hold-trigger-key-positions = <KEYS_RIGHT 7 8 9 10 11 12 13 21 22 23 24 25 26 27 39 40 41 42 43 44 45 54 55 56 57 58 59 71 72 73 74 75>;
            hold-trigger-on-release;
            label = "HLL";
        };

        hlr: home_layer_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <60>;
            tapping-term-ms = <200>;
            quick-tap-ms = <100>;
            bindings = <&mo>, <&kp>;

            hold-trigger-key-positions = <KEYS_LEFT 0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 46 47 48 49 50 51 60 61 62 63 64>;
            hold-trigger-on-release;
            label = "HLR";
        };

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <THUMBS_RIGHT KEYS_RIGHT 7 8 9 10 11 12 13 21 22 23 24 25 26 27 37 38 39 40 41 42 43 44 45 53 54 55 56 57 58 59 68 69 70 71 72 73 74 75>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <THUMBS_LEFT KEYS_LEFT 0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 46 47 48 49 50 51 60 61 62 63 64 35 36 52 64 65 66 67>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        leader {
            key-positions = <32 41>;
            bindings = <&kp BSLH>;
        };

        capsword {
            bindings = <&caps_word>;
            key-positions = <31 42>;
        };

        hdg_q {
            bindings = <&kp Q>;
            key-positions = <15 16>;
        };

        hdg_z {
            bindings = <&kp Z>;
            key-positions = <16 18>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&none      &kp N1     &kp N2    &kp N3        &kp N4        &kp N5  &tog 3                                                             &mo 7      &kp N6  &kp N7        &kp N8        &kp N9    &kp N0            &none
&kp EQUAL  &kp Q      &kp W     &kp E         &kp R         &kp T   &none                                                              &tog 1     &kp Y   &kp U         &kp I         &kp O     &kp P             &kp MINUS
&kp ESC    &hll 4 A   &hll 5 S  &hml LCTRL D  &hml LSHFT F  &kp G   &none     &lt 6 DEL     &kp LALT         &kp RALT     &key_repeat  &tog 2     &kp H   &hmr RSHFT J  &hmr RCTRL K  &hlr 5 L  &hlr 4 SEMICOLON  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C         &kp V         &kp B                           &mkp MB3         &kp RGUI                             &kp N   &kp M         &kp COMMA     &kp DOT   &kp FSLH          &kp RSHFT
&mo 3      &kp GRAVE  &kp CAPS  &kp LEFT      &kp RIGHT             &kp BSPC  &mt LGUI TAB  &key_repeat      &key_repeat  &lt 3 ENTER  &kp SPACE          &kp UP        &kp DOWN      &kp LBKT  &kp RBKT          &mo 3
            >;
        };

        colemak {
            display-name = "COLEMAK";
            bindings = <
&none      &kp N1     &kp N2    &kp N3        &kp N4        &kp N5  &tog 3                                                             &mo 7      &kp N6  &kp N7        &kp N8        &kp N9    &kp N0    &none
&kp EQUAL  &kp Q      &kp W     &kp F         &kp P         &kp B   &none                                                              &trans     &kp J   &kp L         &kp U         &kp Y     &kp SEMI  &kp MINUS
&kp ESC    &hll 4 A   &hll 5 R  &hml LCTRL S  &hml LSHFT T  &kp G   &none     &lt 6 DEL     &kp LALT         &kp RALT     &key_repeat  &none      &kp M   &hmr RSHFT N  &hmr RCTRL E  &hlr 5 I  &hlr 4 O  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C         &kp D         &kp V                           &mkp MB3         &kp RGUI                             &kp K   &kp H         &kp COMMA     &kp DOT   &kp FSLH  &kp RSHFT
&mo 3      &kp GRAVE  &kp CAPS  &kp LEFT      &kp RIGHT             &kp BSPC  &mt LGUI TAB  &key_repeat      &key_repeat  &lt 3 ENTER  &kp SPACE          &kp UP        &kp DOWN      &kp LBKT  &kp RBKT  &mo 3
            >;
        };

        hands_down_gold {
            display-name = "hdg";
            bindings = <
&kp GRAVE  &kp N1    &kp N2    &kp N3        &kp N4        &kp N5  &tog 3                                                              &mo 7      &kp N6    &kp N7        &kp N8        &kp N9    &kp N0    &none
&kp EQUAL  &kp J     &kp G     &kp M         &kp P         &kp V   &none                                                               &trans     &kp SEMI  &kp COMMA     &kp DOT       &kp FSLH  &kp K     &kp MINUS
&kp ESC    &hll 4 R  &hll 5 S  &hml LCTRL N  &hml LSHFT D  &kp B   &none   &lt 6 BACKSPACE  &kp LALT         &kp RALT     &key_repeat  &trans     &none     &hmr RSHFT A  &hmr RCTRL E  &hlr 5 I  &hlr 4 H  &kp SQT
&kp LSHFT  &kp X     &kp F     &kp L         &kp C         &kp W                            &mkp MB3         &kp RGUI                             &none     &kp U         &kp O         &kp Y     &kp K     &kp RSHFT
&mo 3      &kp Q     &kp Z     &kp LEFT      &kp RIGHT             &kp T   &mt LGUI TAB     &key_repeat      &key_repeat  &lt 3 ENTER  &kp SPACE            &kp UP        &kp DOWN      &kp LBKT  &kp RBKT  &mo 3
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &trans  &trans  &trans      &trans  &trans  &trans  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        symbol {
            display-name = "Sym";
            bindings = <
&trans  &trans    &trans     &trans    &trans    &trans     &trans                                      &trans  &trans    &trans     &trans     &trans     &trans    &trans
&trans  &trans    &kp HASH   &kp BSLH  &kp AT    &trans     &trans                                      &trans  &trans    &kp EXCL   &kp STAR   &kp AMPS   &trans    &trans
&trans  &kp PIPE  &kp DQT    &kp LPAR  &kp RPAR  &kp TILDE  &trans  &trans  &trans      &trans  &trans  &trans  &kp PLUS  &kp EQUAL  &kp MINUS  &kp UNDER  &kp PIPE  &trans
&trans  &trans    &kp COMMA  &kp DOT   &kp DLLR  &trans                     &trans      &trans                  &trans    &kp LT     &kp COLON  &kp GT     &trans    &trans
&trans  &trans    &trans     &trans    &trans               &trans  &trans  &trans      &trans  &trans  &trans            &trans     &trans     &trans     &trans    &trans
            >;
        };

        vim_nav {
            display-name = "VIM_NAV";
            bindings = <
&trans  &trans     &trans     &trans    &trans    &trans  &trans                                      &trans  &trans  &trans    &trans    &trans     &trans    &trans
&trans  &trans     &trans     &trans    &trans    &trans  &trans                                      &trans  &trans  &trans    &trans    &trans     &trans    &trans
&trans  &kp CARET  &kp PRCNT  &kp LBKT  &kp RBKT  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &kp LBRC  &kp RBRC  &kp PRCNT  &kp DLLR  &trans
&trans  &trans     &trans     &trans    &trans    &trans                  &trans      &trans                  &trans  &trans    &trans    &trans     &trans    &trans
&trans  &trans     &trans     &trans    &trans            &trans  &trans  &trans      &trans  &trans  &trans          &trans    &trans    &trans     &trans    &trans
            >;

            label = "VIM_NAV";
        };

        nav {
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans  &trans                                      &trans  &trans    &trans     &trans     &trans     &trans  &trans
&trans  &trans    &trans    &trans     &trans     &trans  &trans                                      &trans  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &trans  &trans
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans  &trans
&trans  &trans    &trans    &trans     &trans     &trans                  &trans      &trans                  &trans    &trans     &trans     &trans     &trans  &trans
&trans  &trans    &trans    &trans     &trans             &trans  &trans  &trans      &trans  &trans  &trans            &trans     &trans     &trans     &trans  &trans
            >;

            label = "NAV";
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &none            &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
