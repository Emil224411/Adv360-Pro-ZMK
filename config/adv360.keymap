#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#define KPL 1
#define MOD 2
#define SYM 3
#define NAV 4

#define HM_A hll SYM A
#define HM_S hll KPL S
#define HM_D hml LCTRL D
#define HM_F hml LSHIFT F

#define HM_J    hmr RSHIFT J
#define HM_K    hmr RCTRL K
#define HM_L    hnl NAV L
#define HM_SEMI hlr SYM SEMI

#define KEYS_LEFT  0  1  2  3  4  5  6 \
                  14 15 16 17 18 19 20 \
                  28 29 30 31 32 33 34 \
                  46 47 48 49 50 51    \
                  60 61 62 63 64

#define KEYS_RIGHT  7  8  9 10 11 12 13 \
                   21 22 23 24 25 26 27 \
                   39 40 41 42 43 44 45 \
                      54 55 56 57 58 59 \
                         71 72 73 74 75

#define KEYS_NAV 29 30 31 32             41 42    44 \
                                      54 55 56 57

#define THUMBS_LEFT 35 36 52 65 66 67

#define THUMBS_RIGHT 37 38 53 68 69 70

/ {
    behaviors {
	#include "macros.dtsi"
	#include "version.dtsi"

        hnl: home_row_nav_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
            hold-trigger-key-positions = < KEYS_NAV >;
            hold-trigger-on-release;
        };

        hll: home_row_layer_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
            hold-trigger-key-positions = < KEYS_RIGHT >;
            hold-trigger-on-release;
        };

        hlr: home_row_layer_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
            hold-trigger-key-positions = < KEYS_LEFT >;
            hold-trigger-on-release;
        };

	hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = < KEYS_RIGHT >;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = < KEYS_LEFT >;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";
        leader { // F + J = \
            timeout-ms = <50>;
            key-positions = <32 41>;
            bindings = <&kp BSLH>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&none     &kp N1    &kp N2   &kp N3   &kp N4    &kp N5 &tog 1                                                                   &mo 2 &kp N6 &kp N7 &kp N8    &kp N9   &kp N0   &none
&kp EQUAL &kp Q     &kp W    &kp E    &kp R     &kp T  &none                                                                    &none &kp Y  &kp U  &kp I     &kp O    &kp P    &kp MINUS
&kp ESC   &HM_A     &HM_S    &HM_D    &HM_F     &kp G  &none     &key_repeat   &kp LALT    &kp RALT     &key_repeat             &none &kp H  &HM_J  &HM_K     &HM_L    &HM_SEMI &kp SQT
&kp LSHFT &kp Z     &kp X    &kp C    &kp V     &kp B                          &mkp MB3    &kp RGUI                                   &kp N  &kp M  &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
&mo 1     &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT        &kp BSPC  &hml LGUI TAB &key_repeat &key_repeat  &hmr RCTRL ENTER  &kp SPACE          &kp UP &kp DOWN  &kp LBKT &kp RBKT &mo 1
            >;
        };

        keypad { // L1
            display-name = "Kp";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &tog 1                                      &mo 2   &trans  &trans  &kp EQUAL &kp FSLH &kp STAR  &trans
&trans  &kp F9  &kp F10 &kp F11 &kp F12 &trans  &trans                                      &trans  &trans  &kp N7  &kp N8    &kp N9   &kp MINUS &trans
&trans  &kp F5  &kp F6  &kp F7  &kp F8  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &kp N4  &kp N5    &kp N6   &kp N0    &trans
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &trans                  &trans      &trans                  &trans  &kp N1  &kp N2    &kp N3   &kp PLUS  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans    &kp DOT  &trans    &trans
            >;
        };

        mod { // L2
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &none            &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        symbol { // L3
            display-name = "Sym";
            bindings = <
&trans  &trans    &trans     &trans    &trans    &trans     &trans                                      &trans  &trans    &trans     &trans     &trans     &trans    &trans
&trans  &trans    &kp HASH   &kp BSLH  &kp AT    &trans     &trans                                      &trans  &trans    &kp EXCL   &kp STAR   &kp AMPS   &trans    &trans
&trans  &kp PIPE  &kp DQT    &kp LPAR  &kp RPAR  &kp TILDE  &trans  &trans  &trans      &trans  &trans  &trans  &kp PLUS  &kp EQUAL  &kp MINUS  &kp UNDER  &kp PIPE  &trans
&trans  &trans    &kp COMMA  &kp DOT   &kp DLLR  &trans                     &trans      &trans                  &trans    &kp LT     &kp COLON  &kp GT     &trans    &trans
&trans  &trans    &trans     &trans    &trans               &trans  &trans  &trans      &trans  &trans  &trans            &trans     &trans     &trans     &trans    &trans
            >;
        };

        vim_nav { // L4
            display-name = "Nav";
            bindings = <
&trans  &trans    &trans    &trans   &trans    &trans &trans                                      &trans &trans &trans   &trans   &trans  &trans   &trans
&trans  &trans    &trans    &trans   &trans    &trans &trans                                      &trans &trans &trans   &trans   &trans  &trans   &trans
&trans  &kp CARET &kp PRCNT &kp LBKT &kp RBKT  &trans &trans  &trans  &trans      &trans  &trans  &trans &trans &kp LBRC &kp RBRC &trans  &kp DLLR &trans
&trans  &trans    &kp LEFT  &kp UP   &kp RIGHT &trans                 &trans      &trans                 &trans &trans   &trans   &trans  &trans   &trans
&trans  &trans    &trans    &kp DOWN &trans           &trans  &trans  &trans      &trans  &trans  &trans        &trans   &trans   &trans  &trans   &trans
            >;
        };

    };
};
