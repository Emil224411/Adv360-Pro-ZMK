#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
	#include "macros.dtsi"
	#include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";
        leader {
            timeout-ms = <50>;
            key-positions = <33 38>;
            bindings = <&kp BSLH>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&none      &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &tog 1                                                                       &mo 2            &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &none
&kp EQUAL  &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                                        &to 5            &kp Y   &kp U   &kp I      &kp O     &kp P     &kp MINUS
&kp ESC    &lt 3 A    &lt 4 S   &lt 1 D   &kp F      &kp G   &none           &kp BSLH      &kp LALT         &kp RALT     &kp BSLH         &none            &kp H   &kp J   &kp K      &lt 1 L   &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                                 &mkp MB3         &kp RGUI                                       &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &mt LCTRL BSPC  &mt LGUI TAB  &key_repeat      &key_repeat  &mt RCTRL ENTER  &mt RSHFT SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &none
            >;
        };

        keypad { // L1
            display-name = "Kp";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 2   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &trans  &trans  &trans      &trans  &trans  &trans  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        mod { // L2
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &none            &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        symbol { // L3
            display-name = "Red";
            bindings = <
&trans  &trans    &trans     &trans    &trans    &trans     &trans                                      &mo 2   &trans    &trans     &trans     &trans     &trans    &trans
&trans  &trans    &kp HASH   &kp BSLH  &kp AT    &trans     &trans                                      &trans  &trans    &kp EXCL   &kp STAR   &kp AMPS   &trans    &trans
&trans  &kp BSLH  &kp DQT    &kp LPAR  &kp RPAR  &kp TILDE  &trans  &trans  &trans      &trans  &trans  &trans  &kp PLUS  &kp EQUAL  &kp MINUS  &kp UNDER  &kp PIPE  &trans
&trans  &trans    &kp COMMA  &kp DOT   &kp DLLR  &trans                     &trans      &trans                  &trans    &kp LT     &kp COLON  &kp GT     &trans    &trans
&trans  &trans    &trans     &trans    &trans               &trans  &trans  &trans      &trans  &trans  &trans            &trans     &trans     &trans     &trans    &trans
            >;
        };

        vim_nav { // L4
            display-name = "Purple";
            bindings = <
&trans  &trans     &trans  &trans    &trans    &trans  &trans                                      &mo 2   &trans  &trans    &trans    &trans     &trans    &trans
&trans  &trans     &trans  &trans    &trans    &trans  &trans                                      &trans  &trans  &trans    &trans    &trans     &trans    &trans
&trans  &kp CARET  &trans  &kp LBKT  &kp RBKT  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &kp LBRC  &kp RBRC  &kp PRCNT  &kp DLLR  &trans
&trans  &trans     &trans  &trans    &trans    &trans                  &trans      &trans                  &trans  &trans    &trans    &trans     &trans    &trans
&trans  &trans     &trans  &trans    &trans            &trans  &trans  &trans      &trans  &trans  &trans          &trans    &trans    &trans     &trans    &trans
            >;
        };

        colemakdh { // L5
            display-name = "Base";
            bindings = <
&none      &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &tog 1                                                                       &mo 2            &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &none
&kp EQUAL  &kp Q      &kp W     &kp F     &kp P      &kp B   &none                                                                        &to 0            &kp J   &kp L   &kp U      &kp Y     &kp SEMI  &kp MINUS
&kp ESC    &lt 3 A    &lt 4 R   &lt 1 S   &kp T      &kp G   &none           &kp BSLH      &kp LALT         &kp RALT     &kp BSLH         &none            &kp M   &kp N   &kp E      &lt 1 I   &kp O     &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp D      &kp V                                 &mkp MB3         &kp RGUI                                       &kp K   &kp H   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &mt LCTRL BSPC  &mt LGUI TAB  &key_repeat      &key_repeat  &mt RCTRL ENTER  &mt RSHFT SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &none
            >;
        };

    };
};
